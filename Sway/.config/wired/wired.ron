// Wired reads this file from ~/.config/wired/wired.ron. Its appearance follows
// the charcoal, teal, and red palette used by the Sway window borders and bar.
(
    max_notifications: 4,
    icon_theme: "Adwaita",
    timeout: 6000,
    poll_interval: 16,
    notify_on_reload: false,
    trim_whitespace: true,
    font_options: (hint_style: Slight),
    debug: false,
    layout_blocks: [
        // Keep notifications just below the top edge, clear of the 32px bar.
        // This layout is selected when the sender provides an image or icon.
        (
            name: "root_image",
            parent: "",
            hook: Hook(parent_anchor: TL, self_anchor: TL),
            offset: Vec2(x: 12.0, y: 44.0),
            render_criteria: [HintImage],
            params: NotificationBlock((
                monitor: 0,
                border_width: 2.0,
                border_rounding: 8.0,
                rounded_border_corners: true,
                background_color: Color(hex: "#15171c"),
                border_color: Color(hex: "#1f7a8c"),
                border_color_low: Color(hex: "#30343f"),
                border_color_critical: Color(hex: "#b00020"),
                border_color_paused: Color(hex: "#d08770"),
                gap: Vec2(x: 0.0, y: 10.0),
                notification_hook: Hook(parent_anchor: BL, self_anchor: TL),
            )),
        ),
        (
            name: "image",
            parent: "root_image",
            hook: Hook(parent_anchor: TL, self_anchor: TL),
            offset: Vec2(x: 0.0, y: 0.0),
            params: ImageBlock((
                image_type: Hint,
                padding: Padding(left: 10.0, right: 0.0, top: 10.0, bottom: 10.0),
                rounding: 5.0,
                scale_width: 44,
                scale_height: 44,
                filter_mode: Lanczos3,
            )),
        ),
        (
            name: "summary_image",
            parent: "image",
            hook: Hook(parent_anchor: MR, self_anchor: BL),
            offset: Vec2(x: 0.0, y: 0.0),
            params: TextBlock((
                text: "%s",
                font: "JetBrainsMono Nerd Font Bold 12",
                ellipsize: Middle,
                color: Color(hex: "#d8dee9"),
                color_hovered: Color(hex: "#ffffff"),
                padding: Padding(left: 10.0, right: 10.0, top: 9.0, bottom: 2.0),
                dimensions: (width: (min: 200, max: 340), height: (min: 0, max: 0)),
            )),
        ),
        (
            name: "body_image",
            parent: "summary_image",
            hook: Hook(parent_anchor: BL, self_anchor: TL),
            offset: Vec2(x: 0.0, y: 0.0),
            params: ScrollingTextBlock((
                text: "%b",
                font: "JetBrainsMono Nerd Font 11",
                color: Color(hex: "#c4cbd8"),
                color_hovered: Color(hex: "#ffffff"),
                padding: Padding(left: 10.0, right: 10.0, top: 2.0, bottom: 10.0),
                width: (min: 260, max: 340),
                scroll_speed: 0.08,
                lhs_dist: 24.0,
                rhs_dist: 24.0,
                scroll_t: 1.0,
            )),
        ),

        // The compact variant keeps the same spacing when no image is sent.
        (
            name: "root",
            parent: "",
            hook: Hook(parent_anchor: TL, self_anchor: TL),
            offset: Vec2(x: 12.0, y: 44.0),
            render_anti_criteria: [HintImage],
            params: NotificationBlock((
                monitor: 0,
                border_width: 2.0,
                border_rounding: 8.0,
                rounded_border_corners: true,
                background_color: Color(hex: "#15171c"),
                border_color: Color(hex: "#1f7a8c"),
                border_color_low: Color(hex: "#30343f"),
                border_color_critical: Color(hex: "#b00020"),
                border_color_paused: Color(hex: "#d08770"),
                gap: Vec2(x: 0.0, y: 10.0),
                notification_hook: Hook(parent_anchor: BL, self_anchor: TL),
            )),
        ),
        (
            name: "summary",
            parent: "root",
            hook: Hook(parent_anchor: TL, self_anchor: TL),
            offset: Vec2(x: 0.0, y: 0.0),
            params: TextBlock((
                text: "%s",
                font: "JetBrainsMono Nerd Font Bold 12",
                ellipsize: Middle,
                color: Color(hex: "#d8dee9"),
                color_hovered: Color(hex: "#ffffff"),
                padding: Padding(left: 12.0, right: 12.0, top: 10.0, bottom: 2.0),
                dimensions: (width: (min: 240, max: 360), height: (min: 0, max: 0)),
            )),
        ),
        (
            name: "body",
            parent: "summary",
            hook: Hook(parent_anchor: BL, self_anchor: TL),
            offset: Vec2(x: 0.0, y: 0.0),
            params: ScrollingTextBlock((
                text: "%b",
                font: "JetBrainsMono Nerd Font 11",
                color: Color(hex: "#c4cbd8"),
                color_hovered: Color(hex: "#ffffff"),
                padding: Padding(left: 12.0, right: 12.0, top: 2.0, bottom: 10.0),
                width: (min: 280, max: 360),
                scroll_speed: 0.08,
                lhs_dist: 24.0,
                rhs_dist: 24.0,
                scroll_t: 1.0,
            )),
        ),
    ],
    shortcuts: ShortcutsConfig(
        notification_interact: 1,
        notification_close: 2,
        notification_action1: 3,
    ),
)
