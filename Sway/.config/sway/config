# Load NixOS's Sway session integration, including its systemd targets and
# environment setup.
include /etc/sway/config.d/*

# Set the win key as master key.
set $mod Mod4

# # UI

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:JetBrainsMono Nerd Font 13

# Window title colors. The five columns are border, title background, title
# text, indicator, and child border. High contrast makes tabbed containers much
# easier to scan when several browser windows share the same workspace.
client.focused          #1f7a8c #1f7a8c #ffffff #bfdbf7 #1f7a8c
client.focused_inactive #30343f #30343f #d8dee9 #6b7280 #30343f
client.unfocused        #15171c #15171c #9ca3af #4b5563 #15171c
client.urgent           #b00020 #b00020 #ffffff #ffb4ab #b00020
client.placeholder      #15171c #15171c #9ca3af #4b5563 #15171c

# # Windows management

# Kill focused window with mod+q.
bindsym $mod+q kill

# Change focus with mod+hjkl.
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Split in horizontal orientation with mod+s. Alias "s" as split.
bindsym $mod+s split horizontal
# Split in vertical orientation with mod+v.
bindsym $mod+v split vertical

# Enter fullscreen mode of the focused container with mod+f.
bindsym $mod+f fullscreen toggle

# Organize all windows in tabbed layout.
bindsym $mod+t layout tabbed
# Distribute all windows vertically with Win+-.
bindsym $mod+minus layout splitv
# Distribute all windows horizontally with Win+|.
bindsym $mod+bar layout splith

# Toggle tiling / floating with mod+shift+space.
bindsym $mod+Shift+space floating toggle

# Reload the configuration file.
bindsym $mod+Shift+c reload
# Exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "swaynag -t warning -m 'You pressed the exit shortcut. This will end your Wayland session.' -b 'Yes, exit Sway' 'swaymsg exit'"

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# Move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag enable

# Forbid focus follow mouse. Then you can still focus in a video game even when
# you scoll in web browser window.
focus_follows_mouse no

# No border.
default_border none
default_floating_border pixel 1

# Defalt container layout.
workspace_layout tabbed
# Match i3 by hiding the tab header when its tabbed/stacked container has only
# one child. `none` keeps Sway from hiding borders at screen edges.
hide_edge_borders --i3 none

# Constraining floating window size.
# https://github.com/derf/feh/issues/219#issuecomment-173817516
floating_minimum_size 10 x 10
floating_maximum_size -1 x -1

# Set some arbitrary commands for specific windows.
# Make Google Chrome DevTools do not float again.
for_window [title="^DevTools"] floating disable
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable

# # Workspace management

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
# Pad icon-only workspace names so i3bar reserves enough width for Nerd Font
# glyphs whose rendered shape is wider than their reported text width.
set $ws1 "甲"
set $ws2 "乙"
set $ws3 "丙"
set $ws4 "丁"
set $ws5 "戊"
set $ws6 "己"
set $ws7 "庚"
set $ws8 "辛"
set $ws9 "壬"
set $ws10 "癸"

# Switch to workspace with mod+number.
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# Move focused container to workspace with mod+shift+number.
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindcode 44 resize shrink width 10 px or 10 ppt
        bindcode 45 resize grow height 10 px or 10 ppt
        bindcode 46 resize shrink height 10 px or 10 ppt
        bindcode 47 resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindcode 113 resize shrink width 10 px or 10 ppt
        bindcode 116 resize grow height 10 px or 10 ppt
        bindcode 111 resize shrink height 10 px or 10 ppt
        bindcode 114 resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindcode 36 mode "default"
        bindcode 9 mode "default"
        bindcode $mod+27 mode "default"
}

bindcode $mod+27 mode "resize"

# Automatically putting workspaces on specific screens.
workspace $ws1 output DP-3
workspace $ws2 output DP-2
workspace $ws3 output DP-1
workspace $ws4 output DP-3
workspace $ws5 output DP-2
workspace $ws6 output DP-1
workspace $ws7 output DP-3
workspace $ws8 output DP-2
workspace $ws9 output DP-1

# Automatically back-and-forth when switching to the current workspace
# For instance: Assume you are on workspace "1: www" and switch to "2: IM"
# using mod+2 because somebody sent you a message. You don’t need to remember
# where you came from now, you can just press $mod+2 again to switch back to "1: www".
workspace_auto_back_and_forth yes

# # Additional keymaps

bindsym $mod+Return exec kitty

# Start Nautilus with mod+n.
bindsym $mod+n exec nautilus
# Start a browser with mod+c.
bindsym $mod+c exec google-chrome-stable
# Start the warm Walker service and open it with mod+d.
bindsym $mod+d exec --no-startup-id walker
# Lock
bindsym $mod+shift+l exec swaylock -f
# Select a Clipcat item, then paste it into the application that had focus
# before Walker opened. `&&` prevents a paste if the menu is cancelled.
bindsym $mod+p exec --no-startup-id clipcat-menu insert && wdotool key --clearmodifiers ctrl+v
# Select a region, save the screenshot, and copy it to the clipboard.
bindcode --release 107 exec --no-startup-id "$HOME/.local/bin/screenshot_select.nu"

# # Startups

# greetd starts Sway directly, so start NixOS's XDG autostart target here after
# importing the live Wayland environment. Restart Elephant against this session.
exec --no-startup-id sh -c 'systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK && systemctl --user start xdg-autostart-if-no-desktop-manager.target && systemctl --user restart elephant'

# Keep the three-display layout in Sway so it also applies when outputs reconnect.
# Sway's 270-degree transform preserves the old XRandR left rotation.
output DP-2 mode 1920x1080 position 0 0 transform 270
output DP-3 mode 2560x1440 position 1080 480
output DP-1 mode 1920x1080 position 3640 0 transform 270

# Keep fullscreen apps from triggering the idle lock or display power-off.
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen

# # Scratchpad
# Because conventional $mod+minus is occupied. Use the up-right key of HHKB,
# grave instead. Shift+grave types `~`, which is used to swap letter case in
# Vim, analogous to its assignment here.
bindsym $mod+grave scratchpad show
bindsym $mod+Shift+grave move scratchpad
# Title matching works for both native Wayland and XWayland clients.
for_window [title="^scratchpad$"] move scratchpad
