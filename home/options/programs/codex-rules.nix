{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.programs.codex;

  # A pattern element is either one literal argument or a list of alternatives
  # accepted at that argument position by Codex's prefix-rule engine.
  patternElementType = lib.types.either lib.types.str (lib.types.listOf lib.types.str);

  ruleType = lib.types.submodule {
    options = {
      pattern = lib.mkOption {
        type = lib.types.listOf patternElementType;
        description = "Command argument prefix matched by this Codex rule.";
      };

      decision = lib.mkOption {
        type = lib.types.enum [
          "allow"
          "prompt"
          "forbidden"
        ];
        default = "allow";
        description = "Decision Codex applies when the command prefix matches.";
      };

      justification = lib.mkOption {
        type = lib.types.str;
        description = "Human-readable reason for the command policy.";
      };

      match = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [ ];
        description = "Commands that must match, checked when Codex loads the rules.";
      };

      notMatch = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [ ];
        description = "Commands that must not match, checked when Codex loads the rules.";
      };
    };
  };

  managedToolType = lib.types.submodule {
    options = {
      packages = lib.mkOption {
        type = lib.types.listOf lib.types.package;
        description = "Packages that must be declared in home.packages for this rule group.";
      };

      rules = lib.mkOption {
        type = lib.types.listOf ruleType;
        description = "Rules generated for commands supplied by these packages.";
      };
    };
  };

  renderOptionalExamples =
    name: examples: lib.optionalString (examples != [ ]) "    ${name} = ${builtins.toJSON examples},\n";

  renderRule = rule: ''
    prefix_rule(
        pattern = ${builtins.toJSON rule.pattern},
        decision = ${builtins.toJSON rule.decision},
        justification = ${builtins.toJSON rule.justification},
    ${renderOptionalExamples "match" rule.match}${renderOptionalExamples "not_match" rule.notMatch})
  '';

  managedRules = lib.concatMap (tool: tool.rules) cfg.managedTools;
  managedPackages = lib.concatMap (tool: tool.packages) cfg.managedTools;
  declaredPackagePaths = map toString config.home.packages;
  undeclaredManagedPackages = builtins.filter (
    package: !builtins.elem (toString package) declaredPackagePaths
  ) managedPackages;
  renderedToolsRules = ''
    # Generated by Home Manager from programs.codex.managedTools and
    # programs.codex.systemRules. Change those Nix declarations instead.

    ${lib.concatMapStringsSep "\n" renderRule (managedRules ++ cfg.systemRules)}
  '';
in
{
  options.programs.codex = {
    managedTools = lib.mkOption {
      type = lib.types.listOf managedToolType;
      default = [ ];
      description = ''
        Package groups expected in the Home Manager profile together with the
        Codex command rules that authorize their intended operations. Evaluation
        fails when a referenced package is absent from home.packages.
      '';
    };

    systemRules = lib.mkOption {
      type = lib.types.listOf ruleType;
      default = [ ];
      description = ''
        Command rules for tools supplied by NixOS or another environment rather
        than installed as Codex-managed Home Manager packages.
      '';
    };
  };

  config = {
    programs.codex = {
      managedTools = [
        {
          packages = [
            pkgs.shellcheck
            pkgs.actionlint
            pkgs.hadolint
            pkgs.difftastic
          ];
          rules = [
            {
              pattern = [
                [
                  "shellcheck"
                  "actionlint"
                  "hadolint"
                  "difft"
                ]
              ];
              justification = "Read-only source analysis and reporting";
              match = [
                "shellcheck script.nu"
                "actionlint .github/workflows/check.yml"
              ];
            }
          ];
        }
        {
          packages = [ pkgs.shfmt ];
          rules = [
            {
              pattern = [ "shfmt" ];
              justification = "Allow shell diagnostics and in-place source formatting";
              match = [ "shfmt -w script.sh" ];
            }
          ];
        }
        {
          # These tools also remain in the flake development shell so repository
          # checks are reproducible without activating this Home Manager profile.
          packages = [
            pkgs.deadnix
            pkgs.local.nufmt
            pkgs.statix
            pkgs.desktop-file-utils
            pkgs.selene
            pkgs.nu-lint
          ];
          rules = [
            {
              pattern = [
                [
                  "deadnix"
                  "nufmt"
                  "statix"
                ]
              ];
              justification = "Allow language diagnostics, automatic fixes, and in-place source formatting";
              match = [
                "deadnix --edit flake.nix"
                "nufmt tasks.nu"
                "statix fix ."
              ];
            }
            {
              pattern = [ "desktop-file-validate" ];
              justification = "Validate desktop entries without modifying them";
            }
            {
              pattern = [
                [
                  "selene"
                  "nu-lint"
                ]
              ];
              justification = "Read-only source linting";
            }
          ];
        }
        {
          packages = [ config.programs.git.package ];
          rules = [
            {
              pattern = [
                "git"
                "status"
              ];
              justification = "Report worktree state";
            }
            {
              pattern = [
                "git"
                "diff"
              ];
              justification = "Allow diff inspection, output-file writes, and configured external diff drivers";
              match = [
                "git diff"
                "git diff --output=changes.patch"
                "git diff --ext-diff"
              ];
            }
            {
              pattern = [
                "git"
                "add"
              ];
              justification = "Stage selected worktree changes";
              match = [ "git add home/options/programs/codex-rules.nix" ];
            }
            {
              pattern = [
                "git"
                "commit"
              ];
              justification = "Create a local commit from explicitly staged changes";
              match = [ "git commit -m 'feat(codex): manage command rules'" ];
            }
            {
              pattern = [
                "git"
                "reset"
              ];
              decision = "prompt";
              justification = "Reset can rewrite the index, worktree, or branch history";
              match = [ "git reset --soft HEAD~1" ];
            }
            {
              pattern = [
                "git"
                "push"
              ];
              decision = "prompt";
              justification = "Pushing changes shared remote state";
              match = [ "git push origin main" ];
            }
            {
              # Prefix rules cannot detect a force flag placed after a remote or
              # ref, so block the conventional prefix forms explicitly.
              pattern = [
                "git"
                "push"
                [
                  "-f"
                  "--force"
                ]
              ];
              decision = "forbidden";
              justification = "Push without force, or perform the force-push manually after reviewing remote history";
              match = [
                "git push -f origin main"
                "git push --force origin main"
              ];
              notMatch = [ "git push origin main" ];
            }
          ];
        }
        {
          packages = [ pkgs.local.nur ];
          rules = [
            {
              pattern = [
                "nur"
                "check"
              ];
              justification = "Run the repository's deterministic quality checks";
              match = [ "nur check" ];
            }
          ];
        }
        {
          packages = [ pkgs.gh ];
          rules = [
            {
              pattern = [
                "gh"
                "auth"
                "status"
              ];
              justification = "Inspect GitHub CLI authentication state";
            }
            {
              pattern = [
                "gh"
                "issue"
                "view"
              ];
              justification = "Inspect GitHub issues without changing them";
            }
            {
              pattern = [
                "gh"
                "run"
                [
                  "list"
                  "view"
                  "watch"
                ]
              ];
              justification = "Observe GitHub Actions runs without changing them";
            }
            {
              pattern = [
                "gh"
                "pr"
                [
                  "checks"
                  "list"
                  "status"
                  "view"
                ]
              ];
              justification = "Inspect pull requests without changing them";
            }
          ];
        }
        {
          packages = [ pkgs.tokei ];
          rules = [
            {
              pattern = [ "tokei" ];
              justification = "Read-only source analysis and reporting";
            }
          ];
        }
        {
          packages = [ pkgs.postgresql ];
          rules = [
            {
              pattern = [ "pg_isready" ];
              justification = "Read-only service-readiness query";
              match = [ "pg_isready --timeout=2" ];
            }
          ];
        }
        {
          packages = [ pkgs.pnpm_10_latest ];
          rules = [
            {
              pattern = [
                "pnpm"
                [
                  "list"
                  "why"
                  "view"
                ]
              ];
              justification = "Inspect installed or registry package metadata";
            }
          ];
        }
        {
          packages = [ pkgs.rustup ];
          rules = [
            {
              pattern = [ "rustfmt" ];
              justification = "Allow Rust source formatting";
              match = [ "rustfmt src/main.rs" ];
            }
            {
              pattern = [
                "cargo"
                "fmt"
              ];
              justification = "Allow Cargo formatting, which may rewrite Rust source files";
              match = [
                "cargo fmt"
                "cargo fmt --all"
              ];
            }
          ];
        }
        {
          packages = [
            pkgs.stylua
            pkgs.nixfmt
            pkgs.yamlfmt
            pkgs.taplo
          ];
          rules = [
            {
              pattern = [
                [
                  "stylua"
                  "nixfmt"
                  "yamlfmt"
                  "taplo"
                ]
              ];
              justification = "Allow language diagnostics, automatic fixes, and in-place source formatting";
              match = [
                "stylua ."
                "nixfmt flake.nix"
                "yamlfmt ."
                "taplo format pyproject.toml"
              ];
            }
          ];
        }
      ];

      # NixOS supplies these commands independently of Home Manager, so they
      # have rules but deliberately do not pull duplicate packages into HOME.
      systemRules = [
        {
          pattern = [
            "nix"
            "build"
            "--no-link"
          ];
          justification = "Build a Nix target without creating a result symlink";
          match = [ "nix build --no-link .#checks.x86_64-linux.default" ];
        }
        {
          pattern = [
            [
              "nixos-version"
              "nix-info"
            ]
          ];
          justification = "Read-only system version query";
          match = [ "nixos-version" ];
        }
        {
          pattern = [
            "systemctl"
            "--user"
            "show"
          ];
          justification = "Inspect user service state without changing it";
          match = [
            "systemctl --user show"
            "systemctl --user show panoptor.service"
          ];
        }
      ];
    };

    # Generate package-related permissions from the declarations above. Safety
    # policy stays a reviewed raw artifact, while default.rules remains mutable
    # state maintained by Codex itself.
    home.file.".codex/rules/tools.rules".text = renderedToolsRules;
    home.file.".codex/rules/safety.rules".source = ../../files/codex/safety.rules;

    assertions = [
      {
        assertion = undeclaredManagedPackages == [ ];
        message = ''
          Every programs.codex.managedTools package must also be declared in
          home.packages. Missing: ${lib.concatMapStringsSep ", " lib.getName undeclaredManagedPackages}
        '';
      }
    ];
  };
}
