{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.programs.codex;

  # A pattern element is either one literal argument or a list of alternatives
  # accepted at that argument position by Codex's prefix-rule engine.
  patternElementType = lib.types.either lib.types.str (lib.types.listOf lib.types.str);

  ruleType = lib.types.submodule {
    options = {
      pattern = lib.mkOption {
        type = lib.types.listOf patternElementType;
        description = "Command argument prefix matched by this Codex rule.";
      };

      decision = lib.mkOption {
        type = lib.types.enum [
          "allow"
          "prompt"
          "forbidden"
        ];
        default = "allow";
        description = "Decision Codex applies when the command prefix matches.";
      };

      justification = lib.mkOption {
        type = lib.types.str;
        description = "Human-readable reason for the command policy.";
      };

      match = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [ ];
        description = "Commands that must match, checked when Codex loads the rules.";
      };

      notMatch = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [ ];
        description = "Commands that must not match, checked when Codex loads the rules.";
      };
    };
  };

  managedToolType = lib.types.submodule {
    options = {
      packages = lib.mkOption {
        type = lib.types.listOf lib.types.package;
        description = "Packages that must be declared in home.packages for this rule group.";
      };

      rules = lib.mkOption {
        type = lib.types.listOf ruleType;
        description = "Rules generated for commands supplied by these packages.";
      };
    };
  };

  renderOptionalExamples =
    name: examples: lib.optionalString (examples != [ ]) "    ${name} = ${builtins.toJSON examples},\n";

  renderRule = rule: ''
    prefix_rule(
        pattern = ${builtins.toJSON rule.pattern},
        decision = ${builtins.toJSON rule.decision},
        justification = ${builtins.toJSON rule.justification},
    ${renderOptionalExamples "match" rule.match}${renderOptionalExamples "not_match" rule.notMatch})
  '';

  managedRules = lib.concatMap (tool: tool.rules) cfg.managedTools;
  managedPackages = lib.concatMap (tool: tool.packages) cfg.managedTools;
  declaredPackagePaths = map toString config.home.packages;
  undeclaredManagedPackages = builtins.filter (
    package: !builtins.elem (toString package) declaredPackagePaths
  ) managedPackages;
  renderedToolsRules = ''
    # Generated by Home Manager from programs.codex.managedTools and
    # programs.codex.systemRules. Change those Nix declarations instead.

    ${lib.concatMapStringsSep "\n" renderRule (managedRules ++ cfg.systemRules)}
  '';
in
{
  options.programs.codex = {
    managedTools = lib.mkOption {
      type = lib.types.listOf managedToolType;
      default = [ ];
      description = ''
        Package groups expected in the Home Manager profile together with the
        Codex command rules that authorize their intended operations. Evaluation
        fails when a referenced package is absent from home.packages.
      '';
    };

    systemRules = lib.mkOption {
      type = lib.types.listOf ruleType;
      default = [ ];
      description = ''
        Command rules for tools supplied by NixOS or another environment rather
        than installed as Codex-managed Home Manager packages.
      '';
    };
  };

  config = {
    programs.codex = {
      # Let the upstream Home Manager module place these under CODEX_HOME so
      # home.preferXdgDirectories applies consistently.
      rules = {
        tools = renderedToolsRules;
        safety = ../../files/codex/safety.rules;
      };

      managedTools = [
        {
          packages = [
            pkgs.shellcheck
            pkgs.actionlint
            pkgs.hadolint
            pkgs.difftastic
          ];
          rules = [
            {
              pattern = [
                [
                  "shellcheck"
                  "hadolint"
                  "difft"
                ]
              ];
              justification = "Read-only source analysis and reporting";
              match = [
                "shellcheck script.nu"
              ];
            }
            {
              pattern = [ "actionlint" ];
              decision = "prompt";
              justification = "Review workflow linting that can select external executables through tool options";
              match = [ "actionlint .github/workflows/check.yml" ];
            }
          ];
        }
        {
          packages = [ pkgs.shfmt ];
          rules = [
            {
              pattern = [ "shfmt" ];
              justification = "Allow shell diagnostics and in-place source formatting";
              match = [ "shfmt -w script.sh" ];
            }
          ];
        }
        {
          # These tools also remain in the flake development shell so repository
          # checks are reproducible without activating this Home Manager profile.
          packages = [
            pkgs.deadnix
            pkgs.local.nufmt
            pkgs.statix
            pkgs.desktop-file-utils
            pkgs.selene
            pkgs.nu-lint
          ];
          rules = [
            {
              pattern = [
                [
                  "deadnix"
                  "nufmt"
                  "statix"
                ]
              ];
              justification = "Allow language diagnostics, automatic fixes, and in-place source formatting";
              match = [
                "deadnix --edit flake.nix"
                "nufmt tasks.nu"
                "statix fix ."
              ];
            }
            {
              pattern = [ "desktop-file-validate" ];
              justification = "Validate desktop entries without modifying them";
            }
            {
              pattern = [
                [
                  "selene"
                  "nu-lint"
                ]
              ];
              justification = "Read-only source linting";
            }
          ];
        }
        {
          packages = [ config.programs.git.package ];
          rules = [
            {
              pattern = [
                "git"
                "status"
              ];
              justification = "Report worktree state";
            }
            {
              pattern = [
                "git"
                "diff"
              ];
              # Trailing flags can re-enable external drivers or choose output
              # files, so a supposedly safe leading flag cannot narrow this.
              decision = "prompt";
              justification = "Review diff options that can write output files or execute external diff and text-conversion drivers";
              match = [
                "git diff"
                "git diff --output=changes.patch"
                "git diff --ext-diff"
              ];
            }
            {
              pattern = [
                "git"
                "add"
              ];
              decision = "prompt";
              justification = "Review staged paths; force-add can include ignored secrets and broad pathspecs can include unrelated work";
              match = [ "git add home/options/programs/codex-rules.nix" ];
            }
            {
              pattern = [
                "git"
                "commit"
              ];
              decision = "prompt";
              justification = "Review commit scope, history amendments, hook execution, and verification bypass options";
              match = [ "git commit -m 'feat(codex): manage command rules'" ];
            }
            {
              pattern = [
                "git"
                [
                  "clone"
                  "pull"
                ]
              ];
              decision = "prompt";
              justification = "Review remote helpers, configuration, hooks, destination paths, and history integration before fetching repository content";
              match = [
                "git clone https://example.invalid/repo.git"
                "git pull --rebase origin topic"
              ];
            }
            {
              pattern = [
                "git"
                "reset"
              ];
              decision = "prompt";
              justification = "Reset can rewrite the index, worktree, or branch history";
              match = [ "git reset --soft HEAD~1" ];
            }
            {
              pattern = [
                "git"
                "push"
              ];
              decision = "prompt";
              justification = "Pushing changes shared remote state";
              match = [ "git push origin main" ];
            }
          ];
        }
        {
          packages = [ pkgs.local.nur ];
          rules = [
            {
              pattern = [
                "nur"
              ];
              # All Nur tasks are intentionally approved, including new tasks
              # and deployment tasks. This does not establish repository trust
              # or authorize NixOS deployment; those instructions still apply.
              justification = "Allow every Nur command and task; execute repository tasks only with the required trust or outer sandbox";
              match = [
                "nur --list"
                "nur check"
                "nur panoptor list"
                "nur switch-nixos"
              ];
            }
          ];
        }
        {
          packages = [ pkgs.gh ];
          rules = [
            {
              pattern = [
                "gh"
                "auth"
                "status"
              ];
              decision = "prompt";
              justification = "Review authentication status options because --show-token and -t can disclose credentials";
              match = [
                "gh auth status"
                "gh auth status --show-token"
              ];
            }
            {
              pattern = [
                "gh"
                "issue"
                "view"
              ];
              justification = "Inspect GitHub issues without changing them";
            }
            {
              pattern = [
                "gh"
                "run"
                [
                  "list"
                  "view"
                  "watch"
                ]
              ];
              justification = "Observe GitHub Actions runs without changing them";
            }
            {
              pattern = [
                "gh"
                "pr"
                [
                  "checks"
                  "list"
                  "status"
                  "view"
                ]
              ];
              justification = "Inspect pull requests without changing them";
            }
            {
              pattern = [
                "gh"
                "repo"
                "fork"
              ];
              decision = "prompt";
              justification = "Review remote fork creation, optional cloning, and local remote changes";
              match = [ "gh repo fork owner/repo --clone" ];
            }
            {
              pattern = [
                "gh"
                "repo"
                "list"
              ];
              justification = "List repositories visible to the authenticated GitHub account";
            }
            {
              pattern = [
                "gh"
                "search"
                "prs"
              ];
              justification = "Search GitHub pull requests without changing remote state";
            }
          ];
        }
        {
          packages = [ pkgs.tokei ];
          rules = [
            {
              pattern = [ "tokei" ];
              justification = "Read-only source analysis and reporting";
            }
          ];
        }
        {
          packages = [ pkgs.postgresql ];
          rules = [
            {
              pattern = [ "pg_isready" ];
              justification = "Read-only service-readiness query";
              match = [ "pg_isready --timeout=2" ];
            }
          ];
        }
        {
          packages = [ pkgs.pnpm_10_latest ];
          rules = [
            {
              pattern = [
                "pnpm"
                [
                  "list"
                  "why"
                  "view"
                ]
              ];
              justification = "Inspect installed or registry package metadata";
            }
          ];
        }
        {
          packages = [ pkgs.rustup ];
          rules = [
            {
              pattern = [ "rustfmt" ];
              justification = "Allow Rust source formatting";
              match = [ "rustfmt src/main.rs" ];
            }
            {
              pattern = [
                "cargo"
                "fmt"
              ];
              justification = "Allow Cargo formatting, which may rewrite Rust source files";
              match = [
                "cargo fmt"
                "cargo fmt --all"
              ];
            }
          ];
        }
        {
          packages = [
            pkgs.stylua
            pkgs.nixfmt
            pkgs.yamlfmt
            pkgs.taplo
          ];
          rules = [
            {
              pattern = [
                [
                  "stylua"
                  "nixfmt"
                  "yamlfmt"
                ]
              ];
              justification = "Allow language diagnostics, automatic fixes, and in-place source formatting";
              match = [
                "stylua ."
                "nixfmt flake.nix"
                "yamlfmt ."
              ];
            }
            {
              pattern = [
                "taplo"
                [
                  "format"
                  "lint"
                ]
              ];
              justification = "Format and validate TOML files without approving unrelated Taplo subcommands";
              match = [
                "taplo format pyproject.toml"
                "taplo lint pyproject.toml"
              ];
            }
          ];
        }
      ];

      # NixOS and other configuration modules supply these commands outside the
      # managedTools package groups. Keep their policy here rather than in a
      # separate saved-approval file so every command has one declarative owner.
      systemRules = [
        {
          # The trusted launcher supplies containment independently of Codex
          # approvals; the worker must still follow repository trust rules.
          pattern = [ "codex-sandbox" ];
          justification = "Run the trusted outer sandbox; repository trust and containment requirements still apply";
        }
        {
          pattern = [
            "nh"
            "home"
            "switch"
          ];
          decision = "prompt";
          justification = "Review the selected Home Manager configuration and activation scripts before running them with user privileges";
          match = [
            "nh home switch"
            "nh home switch --file other.nix"
          ];
        }
        {
          pattern = [
            "nix"
            "build"
          ];
          decision = "prompt";
          justification = "Review build targets and options; --no-link suppresses a result symlink but does not restrict evaluation or builds";
          match = [ "nix build --no-link .#checks.x86_64-linux.default" ];
        }
        {
          # Leading flags cannot restrict trailing commands or shell hooks.
          pattern = [
            "nix"
            "develop"
          ];
          decision = "prompt";
          justification = "Review development-shell hooks and arbitrary commands selected with -c before host execution";
          match = [
            "nix develop --no-update-lock-file -c nur check"
            "nix develop -c bash"
          ];
        }
        {
          pattern = [
            "nix"
            "flake"
            [
              "check"
              "metadata"
            ]
          ];
          decision = "prompt";
          justification = "Review the selected flake and options before evaluation, builds, downloads, or lock-file changes";
          match = [
            "nix flake check"
            "nix flake metadata"
          ];
        }
        {
          pattern = [
            [
              "nixos-version"
              "nix-info"
            ]
          ];
          justification = "Read-only system version query";
          match = [ "nixos-version" ];
        }
        {
          pattern = [
            "npm"
            "view"
          ];
          justification = "Read package registry metadata without installing packages or running lifecycle scripts";
        }
        {
          pattern = [
            "systemctl"
            "--user"
            "show"
          ];
          justification = "Inspect user service state without changing it";
          match = [
            "systemctl --user show"
            "systemctl --user show panoptor.service"
          ];
        }
      ];
    };

    assertions = [
      {
        assertion = undeclaredManagedPackages == [ ];
        message = ''
          Every programs.codex.managedTools package must also be declared in
          home.packages. Missing: ${lib.concatMapStringsSep ", " lib.getName undeclaredManagedPackages}
        '';
      }
    ];
  };
}
