#!/usr/bin/env nu

const launcher = path self sandbox

def launch [args: list<string>, no_nix_daemon: bool] {
    let codex_home = $env.CODEX_HOME? | default ($env.XDG_CONFIG_HOME | path join "codex")
    mut launcher_args = [
        "--state-dir" $codex_home
        "--state-env" "CODEX_HOME"
        "--private-state-subdir" "ipc"
    ]
    if $no_nix_daemon {
        $launcher_args = $launcher_args | append "--no-nix-daemon"
    }

    # Bubblewrap is the complete containment boundary: it limits the worker to
    # this repository, private agent state, and the deliberately exposed system
    # resources. Avoid a second policy that can pause delegation or disagree
    # about that boundary.
    ^$launcher ...$launcher_args codex --dangerously-bypass-approvals-and-sandbox ...$args
}

# Run Codex with its own state inside the common untrusted-repository sandbox.
def --wrapped main [
    # Run without access to the host's multi-user Nix daemon.
    --no-nix-daemon
    # Arguments and flags passed unchanged to Codex.
    ...args: string
] {
    launch $args $no_nix_daemon
}

# Run one non-interactive Codex task inside the Bubblewrap containment boundary
# and then exit. The launcher disables Codex's inner approval and sandbox layer;
# Bubblewrap remains the policy that limits the worker's authority.
def --wrapped "main exec" [
    # Run without access to the host's multi-user Nix daemon.
    --no-nix-daemon
    # Task for the sandboxed Codex worker to complete.
    prompt: string
    # Additional arguments and flags passed to `codex exec`.
    ...args: string
] {
    launch (["exec" $prompt] | append $args) $no_nix_daemon
}
