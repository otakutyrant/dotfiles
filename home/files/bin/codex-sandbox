#!/usr/bin/env nu

const launcher = path self sandbox

def launch [args: list<string>, no_nix_daemon: bool] {
    let codex_home = $env.CODEX_HOME? | default ($env.XDG_CONFIG_HOME | path join "codex")
    mut launcher_args = [
        "--state-dir" $codex_home
        "--state-env" "CODEX_HOME"
        "--private-state-subdir" "ipc"
    ]
    if $no_nix_daemon {
        $launcher_args = $launcher_args | append "--no-nix-daemon"
    }

    ^$launcher ...$launcher_args codex ...$args
}

# Run Codex with its own state inside the common untrusted-repository sandbox.
def --wrapped main [
    # Run without access to the host's multi-user Nix daemon.
    --no-nix-daemon
    # Arguments and flags passed unchanged to Codex.
    ...args: string
] {
    launch $args $no_nix_daemon
}

# Run one non-interactive Codex task inside the sandbox and then exit. Bounded
# tasks default to workspace-write because the outer sandbox already limits
# writes to the current repository; callers can pass an explicit --sandbox
# option when a read-only delegation is wanted.
def --wrapped "main exec" [
    # Run without access to the host's multi-user Nix daemon.
    --no-nix-daemon
    # Task for the sandboxed Codex worker to complete.
    prompt: string
    # Additional arguments and flags passed to `codex exec`.
    ...args: string
] {
    let has_sandbox_mode = $args | any {|arg|
        ($arg == "--sandbox") or ($arg | str starts-with "--sandbox=")
    }
    let default_sandbox_args = if $has_sandbox_mode {
        []
    } else {
        ["--sandbox" "workspace-write"]
    }
    launch ((["exec" $prompt] | append $default_sandbox_args) | append $args) $no_nix_daemon
}
