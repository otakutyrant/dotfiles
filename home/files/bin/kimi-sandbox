#!/usr/bin/env nu

const launcher = path self sandbox

def launch [args: list<string>, no_nix_daemon: bool] {
    let kimi_home = $env.KIMI_CODE_HOME? | default ($env.XDG_CONFIG_HOME | path join "kimi-code")
    mut launcher_args = [
        "--state-dir" $kimi_home
        "--state-env" "KIMI_CODE_HOME"
        "--private-state-subdir" "server"
    ]
    if $no_nix_daemon {
        $launcher_args = $launcher_args | append "--no-nix-daemon"
    }

    # Sandboxed Kimi sessions are unattended by default, so let Kimi decide
    # and act without pausing for approval prompts.
    ^$launcher ...$launcher_args kimi --auto ...$args
}

# Run Kimi Code with its own state and the shared global agent instructions.
def --wrapped main [
    # Run without access to the host's multi-user Nix daemon.
    --no-nix-daemon
    # Arguments and flags passed unchanged to Kimi Code.
    ...args: string
] {
    launch $args $no_nix_daemon
}

# Run one non-interactive Kimi Code task inside the sandbox and then exit.
def --wrapped "main exec" [
    # Run without access to the host's multi-user Nix daemon.
    --no-nix-daemon
    # Task for the sandboxed Kimi Code worker to complete.
    prompt: string
    # Additional arguments and flags passed to Kimi Code's prompt mode.
    ...args: string
] {
    launch (["--prompt" $prompt] | append $args) $no_nix_daemon
}
