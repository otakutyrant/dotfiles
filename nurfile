#!/usr/bin/env nu

# Keep this manageable task catalog in one file; Process Compose owns watches.
# nu-lint-ignore-file: dont_mix_different_effects, missing_output_type
# nu-lint-ignore-file: print_and_return_data, unhandled_external_error

def checked-files [extension: string] {
    ^git ls-files --cached --others --exclude-standard
    | lines
    | where {|path| ($path | str ends-with $extension) and ($path | path exists) }
    | sort
    | uniq
}

def nix-files [] {
    checked-files ".nix"
    | where {|path| $path != "nixos/hardware-configuration.nix" }
}

def lua-files [] {
    checked-files ".lua"
}

def nu-files [] {
    checked-files ".nu"
    | append "nurfile"
    | sort
    | uniq
}

def markdown-files [] {
    checked-files ".md"
}

def formatted-nu-files [] {

    # This Home Manager replaceVars template becomes valid Nu only after Nix
    # substitutes its @sessionPath@ placeholder.
    nu-files | where {|path| $path != "home/options/programs/nushell/extra-env.nu" }
}

def architecture-violations [files: list<record>] {
    $files
    | each { |file|
        if ($file.path | str starts-with "home/") and ($file.content | str contains "../nixos") {
            { path: $file.path, forbidden: "nixos/" }
        } else if ($file.path | str starts-with "nixos/") and ($file.content | str contains "../home") {
            { path: $file.path, forbidden: "home/" }
        } else if ($file.path | str starts-with "lib/") and (($file.content | str contains "../home") or ($file.content | str contains "../nixos")) {
            { path: $file.path, forbidden: "configuration tree" }
        }
    }
    | compact
}

def assert-no-architecture-violations [files: list<record>] {
    let violations = (architecture-violations $files)
    if ($violations | is-not-empty) {
        let details = (
            $violations
            | each {|item| $"($item.path) imports forbidden ($item.forbidden)" }
            | str join "; "
        )
        error make {msg: $"Architecture boundary violation: ($details)"}
    }
}

def ensure-success [result: record, operation: string] {
    if $result.exit_code != 0 {
        let message = $result.stderr | str trim
        error make {msg: $"($operation) failed: ($message)"}
    }
}

# Format checked-in Nix files, excluding the generated hardware configuration.
export def "nur format-nix" [] {
    let files = (nix-files)
    if ($files | is-not-empty) {
        ^nixfmt ...$files
    }
}

# Format checked-in Lua files.
export def "nur format-lua" [] {
    let files = (lua-files)
    if ($files | is-not-empty) {
        ^stylua ...$files
    }
}

# Format checked-in Nushell files with the pinned upstream nufmt release.
export def "nur format-nushell" [] {
    let files = (formatted-nu-files)
    if ($files | is-not-empty) {
        ^nufmt --shebang ...$files
    }
}

# Format checked-in Markdown files with the shared Prettier configuration.
export def "nur format-markdown" [] {
    let files = (markdown-files)
    if ($files | is-not-empty) {
        ^prettier --write ...$files
    }
}

# Format every source language with an approved safe formatter.
export def "nur format" [] {
    nur format-nix
    nur format-lua
    nur format-nushell
    nur format-markdown
}

# Check Nix formatting, suspicious constructs, and unused bindings.
export def "nur lint-nix" [] {
    let files = (nix-files)
    if ($files | is-empty) {
        return
    }

    ^nixfmt --check ...$files
    for file in $files {
        ^statix check $file
        ^deadnix --fail $file
    }
}

# Check Lua formatting and lint diagnostics.
export def "nur lint-lua" [] {
    let files = (lua-files)
    if ($files | is-empty) {
        return
    }

    ^stylua --check ...$files
    ^selene ...$files
}

# Check Nushell formatting, idioms, and unused code without rewriting source files.
export def "nur lint-nushell" [] {
    let files = (formatted-nu-files)
    if ($files | is-not-empty) {
        ^nufmt --dry-run --shebang ...$files
        ^nu-lint ...($files | where {|file| $file != "nurfile" })
        open --raw nurfile | ^nu-lint --stdin
    }
}

# Check Markdown formatting without changing files.
export def "nur lint-markdown" [] {
    let files = (markdown-files)
    if ($files | is-not-empty) {
        ^prettier --check ...$files
    }
}

# Run all source linters without modifying files.
export def "nur lint" [] {
    nur lint-nix
    nur lint-lua
    nur lint-nushell
    nur lint-markdown
}

# Evaluate both supported Nix configuration outputs.
export def "nur typecheck-nix" [] {
    # Nix has no separate type checker. Evaluating the derivation paths checks
    # flake evaluation plus the NixOS and Home Manager module types.
    let nixos = (
        ^nix eval --no-update-lock-file --raw ".#nixosConfigurations.nixos.config.system.build.toplevel.drvPath"
        | complete
    )
    ensure-success $nixos "NixOS evaluation"

    let home = (
        ^nix eval --no-update-lock-file --raw ".#homeConfigurations.otakutyrant.activationPackage.drvPath"
        | complete
    )
    ensure-success $home "Home Manager evaluation"
}

# Run LuaLS diagnostics, failing only on Error-level findings.
export def "nur typecheck-lua" [] {
    ^lua-language-server --check . --checklevel Error --check_format pretty --logpath /tmp/dotfiles-lua-language-server-log
}

# Check every Nushell source and directly source autoload modules.
export def "nur typecheck-nushell" [] {
    let files = (nu-files)
    for file in ($files | where {|path| $path | str contains "/autoload/" }) {
        ^nu -n -c $"source ($file)"
    }

    for file in $files {
        ^nu --ide-check 0 $file | ignore
    }
}

# Run all type-aware and parser diagnostics.
export def "nur typecheck" [] {
    nur typecheck-nix
    nur typecheck-lua
    nur typecheck-nushell
}

# Validate raw data files without imposing new formatting.
export def "nur validate-data" [] {
    let yaml_files = (
        (checked-files ".yaml")
        | append (checked-files ".yml")
        | where {|path| not ($path | str ends-with ".dict.yaml") }
    )
    for file in $yaml_files {
        let result = (^yq eval "." $file | complete)
        ensure-success $result $"YAML validation for ($file)"
    }

    let toml_files = (checked-files ".toml")
    if ($toml_files | is-not-empty) {
        let result = (^taplo lint ...$toml_files | complete)
        ensure-success $result "TOML validation"
    }

    let json_files = (checked-files ".json")
    if ($json_files | is-not-empty) {
        let result = (^jq empty ...$json_files | complete)
        ensure-success $result "JSON validation"
    }

    let desktop_files = (checked-files ".desktop")
    if ($desktop_files | is-not-empty) {
        let result = (^desktop-file-validate ...$desktop_files | complete)
        ensure-success $result "desktop entry validation"
    }
}

# Reject direct dependencies between system, user, and shared Nix layers.
export def "nur architecture" [] {
    let files = (
        checked-files ".nix"
        | where {|path| ($path | str starts-with "home/") or ($path | str starts-with "nixos/") or ($path | str starts-with "lib/") }
        | each {|path| { path: $path, content: (open --raw $path) } }
    )
    assert-no-architecture-violations $files
}

# Exercise representative allowed and forbidden Nix dependency boundaries.
export def "nur test-architecture" [] {
    assert-no-architecture-violations [
        {
            path: "home/options/example.nix"
            content: "import ../../../lib/example.nix"
        }
        {
            path: "nixos/options/example.nix"
            content: "import ../../lib/example.nix"
        }
        {path: "lib/example.nix", content: "{ lib }: lib.id"}
    ]

    let forbidden = (architecture-violations [
        { path: "home/options/example.nix", content: "import ../../../nixos/example.nix" }
        { path: "nixos/options/example.nix", content: "import ../../home/example.nix" }
        { path: "lib/example.nix", content: "import ../home/example.nix" }
    ])
    if ($forbidden | length) != 3 {
        error make {msg: "Architecture fixtures did not reject every forbidden dependency"}
    }
}

# Verify that command runners which unconditionally invoke /bin/sh can start
# inside the otherwise minimal sandbox without changing its Nushell default.
export def "nur test-sandbox-shell" [] {
    let result = (
        ^home/files/bin/sandbox --no-nix-daemon /bin/sh -c 'test "$SHELL" = /run/current-system/sw/bin/nu'
        | complete
    )
    ensure-success $result "Sandbox /bin/sh compatibility check"
}

# Run all deterministic repository tests.
export def "nur test" [] {
    nur test-architecture
    nur test-sandbox-shell
}

# Run repository structure, raw-data, and deterministic fixture checks.
export def "nur verify" [] {
    nur architecture
    nur validate-data
    nur test
}

# Run every deterministic repository quality check in fail-fast order.
export def "nur check" [] {
    nur lint
    nur typecheck
    nur verify
}

# Build the NixOS configuration without activating it.
export def "nur build-nixos" [] {
    ^nh os build ".#nixos" --no-update-lock-file
}

# Build the standalone Home Manager configuration without activating it.
export def "nur build-home" [] {
    ^nh home build . --configuration otakutyrant --no-update-lock-file
}

# Build and activate the NixOS configuration. Run only when explicitly requested.
export def "nur switch-nixos" [] {
    ^nh os switch ".#nixos" --no-update-lock-file
}

# Build and activate Home Manager. Run only when explicitly requested.
export def "nur switch-home" [] {
    ^nh home switch . --configuration otakutyrant --no-update-lock-file
}

# Process Compose-backed control surface for one worktree's validation roles.

const PROJECT_ROOT = path self | path dirname
const CONFIG_PATH = $PROJECT_ROOT | path join process-compose.yaml
const PROJECT_NAME = "dotfiles"

def repository-root []: nothing -> string {
    let result = ^git -C $PROJECT_ROOT rev-parse --show-toplevel | complete
    if $result.exit_code != 0 {
        error make {
            msg: ($result.stderr | str trim)
        }
    }
    $result.stdout | str trim | path expand
}

def worktree-id []: nothing -> string {
    repository-root | hash sha256 | str substring 0..11
}

def runtime-directory []: nothing -> string {
    let base = $env.XDG_RUNTIME_DIR? | default null
    if $base == null {
        error make {
            msg: "XDG_RUNTIME_DIR is required for Panoptor's private runtime state."
        }
    }
    $base | path join $PROJECT_NAME $"panoptor-(worktree-id)"
}

def socket-path []: nothing -> string {
    runtime-directory | path join process-compose.sock
}

def client-log-path []: nothing -> string {
    runtime-directory | path join client.log
}

def server-log-path []: nothing -> string {
    runtime-directory | path join server.log
}

def prepare-runtime-directory [] {
    let directory = runtime-directory
    mkdir $directory
    ^chmod 700 $directory
}

def --wrapped client-result [...arguments: string]: nothing -> record {
    ^process-compose --use-uds --unix-socket (socket-path) --log-file (client-log-path) ...$arguments | complete
}

def require-session [] {
    if (client-result process list --output json).exit_code != 0 {
        error make {
            msg: "No dotfiles Panoptor session is running."
            help: "Run `nur panoptor start`."
        }
    }
}

def process-state [role: string]: nothing -> string {
    let listing = client-result process list --output json
    if $listing.exit_code != 0 {
        error make {
            msg: "Could not read Panoptor process state."
            help: ($listing.stderr | str trim)
        }
    }
    let processes = try {
        $listing.stdout | from json
    } catch {
        error make {msg: "Process Compose returned invalid JSON process state."}
    }
    let process = $processes | where name == $role | get --optional 0
    if $process == null {
        error make {
            msg: $"Unknown Panoptor role '($role)'."
            help: "Run `nur panoptor list`."
        }
    }
    # The pinned nu-lint parser still recognizes the pre-0.114 spelling.
    $process.status? | default unknown | into string | str downcase
}

def run-role-action [action: string, role: string] {
    require-session
    let actual_action = if $action == rerun {
        let state = process-state $role
        if $state in [running ready launching pending] { "restart" } else { "start" }
    } else {
        $action
    }
    if $actual_action not-in [start stop restart] {
        error make {msg: "Role action must be 'start', 'stop', 'restart', or 'rerun'."}
    }
    let result = client-result process $actual_action $role
    if $result.exit_code != 0 {
        error make {
            msg: $"Could not ($actual_action) Panoptor role '($role)'."
            help: (($result.stdout + $result.stderr) | str trim)
        }
    }
    print $"($role): ($actual_action) requested."
}

def start-panoptor [] {
    prepare-runtime-directory
    let socket = socket-path
    if (client-result process list --output json).exit_code == 0 {
        error make {
            msg: "Dotfiles Panoptor is already running."
            help: "Run `nur panoptor list` or `nur panoptor attach`."
        }
    }
    if ($socket | path exists) {
        rm --force $socket
    }
    let started = with-env {PANOPTOR_PROJECT_ROOT: (repository-root)} {
        ^process-compose --use-uds --unix-socket $socket --log-file (server-log-path) --ordered-shutdown up --config $CONFIG_PATH --detached --tui=false --disable-dotenv --keep-project | complete
    }
    if $started.exit_code != 0 {
        error make {
            msg: "Process Compose could not start dotfiles Panoptor."
            help: (($started.stdout + $started.stderr) | str trim)
        }
    }
    for _ in 1..40 {
        if (client-result process list --output json).exit_code == 0 {
            print $"Dotfiles Panoptor started for worktree (worktree-id)."
            return
        }
        sleep 250ms
    }
    error make {
        msg: "Panoptor did not open its control socket."
        help: $"Inspect (server-log-path)."
    }
}

def stop-panoptor [] {
    require-session
    let stopped = client-result down
    if $stopped.exit_code != 0 {
        error make {
            msg: "Process Compose could not stop dotfiles Panoptor."
            help: (($stopped.stdout + $stopped.stderr) | str trim)
        }
    }
    print "Dotfiles Panoptor stopped."
}

# Show every subcommand's usage without accessing or changing session state.
export def "nur panoptor" []: nothing -> string {
    help commands
    | where name =~ '^nur panoptor '
    | each {|command| help $command.name }
    | str join "\n\n"
}

# Validate the checked-in Process Compose graph without starting its roles.
export def "nur panoptor check" [] {
    with-env {PANOPTOR_PROJECT_ROOT: (repository-root)} {
        ^process-compose up --config $CONFIG_PATH --dry-run --disable-dotenv --tui=false
    }
}

# Start this worktree's validation topology headlessly.
export def "nur panoptor start" [] {
    start-panoptor
}

# Stop this worktree's roles and Process Compose server.
export def "nur panoptor stop" [] {
    stop-panoptor
}

# Attach the TUI without changing the session lifecycle.
export def "nur panoptor attach" [] {
    prepare-runtime-directory
    require-session
    ^process-compose --use-uds --unix-socket (socket-path) --log-file (client-log-path) attach
}

# List role liveness and readiness, optionally as JSON.
export def "nur panoptor list" [--json] {
    prepare-runtime-directory
    require-session
    let output = if $json { "json" } else { "wide" }
    ^process-compose --use-uds --unix-socket (socket-path) --log-file (client-log-path) process list --output $output
}

# Print a bounded tail from one role's log buffer.
export def "nur panoptor output" [role: string, --tail: int = 100] {
    prepare-runtime-directory
    require-session
    if $tail < 1 {
        error make {msg: "--tail must be a positive line count."}
    }
    ^process-compose --use-uds --unix-socket (socket-path) --log-file (client-log-path) process logs $role --tail $tail
}

# Start, stop, restart, or freshly rerun one role.
export def "nur panoptor role" [action: string, role: string] {
    prepare-runtime-directory
    run-role-action $action $role
}

# Recover one role, or restart the complete worktree topology.
export def "nur panoptor recover" [role?: string] {
    prepare-runtime-directory
    if $role == null {
        stop-panoptor
        start-panoptor
    } else {
        run-role-action rerun $role
    }
}
