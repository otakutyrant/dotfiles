[Desktop Entry]
Type=Application
Version=1.5
Name=Kitty CI
GenericName=Kitty CI Session
Comment=Open a Kitty terminal with the CI session
Exec=/etc/profiles/per-user/otakutyrant/bin/direnv exec /home/otakutyrant/Projects/ci nur session
Path=/home/otakutyrant/Projects/ci
Icon=terminal
Categories=System;TerminalEmulator;
Terminal=false
