#!/usr/bin/env nu

def lmp3 [filename: string] {
    let duration = (
        ffprobe $"($filename)" -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1
        | str trim
        | into int
        | into duration --unit sec
    )

    let srt_filename = $filename | str replace "mp3" "srt"
    let content = open $srt_filename
    let lines = $content | lines | each { |line| $line | str trim } | where { |line|
            not ($line =~ '^\d+$'
            or $line =~ '^\d\d:\d\d:\d\d,\d{3} --> '
            or $line == '')
        }
    let count = $lines | reduce -f 0 { |line, acc| $acc + ($line | str length -g) }
    let seconds = ($duration | into int) // 1_000_000_000
    let cps = $count / $seconds

    {
        name: $filename
        duration: $duration
        chars: $count
        cps: $cps
    }
}

# List mp3 files in a directory with audio duration, subtitle character count,
# and average characters per second.
def main [directory: path = .] {
    if not ($directory | path exists) or (($directory | path type) != "dir") {
        error make {
            msg: $"{$directory} is not a directory"
        }
    }

    let file_list = (ls ($"($directory)/*.mp3" | into glob) | where type == 'file' | each { |it| lmp3 $it.name })
    let total_durations = $file_list | get duration | math sum
    let average_duration = $file_list | get duration | math avg | format duration sec | split row " " | get 0 | into int | into string | append "sec" | str join | into duration
    let total_chars = $file_list | get chars | math sum
    let average_chars = $file_list | get chars | math avg | into int
    let total_seconds = ($total_durations | into int) // 1_000_000_000
    let avarage_cps = $total_chars / $total_seconds

    $file_list | append {
            name: "TOTAL", duration: $total_durations, chars: $total_chars
        } | append {
            name: "AVERAGE", duration: $average_duration chars: $average_chars
            cps: $avarage_cps
        }
}
