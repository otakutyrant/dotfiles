#!/usr/bin/env nu

# Wrap the real Neovim-backed `page` so piped text is fully collected before
# `page` starts. This avoids typing search keys while `page` is still appending
# command output into its buffer.
def --wrapped main [...args: string] {
    let wrapper = ($env.HOME | path join ".local/bin/page" | path expand)
    # Skip this wrapper because ~/.local/bin comes before the real `page` in PATH.
    let real_page = (
        $env.PATH
        | each {|dir| $dir | path join "page" }
        | where {|candidate| ($candidate | path exists) and (($candidate | path expand) != $wrapper) }
        | first
    )

    if ($in == null) {
        ^$real_page ...$args
    } else {
        $in | collect | ^$real_page ...$args
    }
}
